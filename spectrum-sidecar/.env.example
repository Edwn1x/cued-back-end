# Photon / Spectrum Cloud project credentials (dashboard → project Settings).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Shared with the Flask `web` service. Generate: openssl rand -hex 32
INTERNAL_SHARED_SECRET=

# Where inbound iMessages are forwarded. Railway: http://${{web.RAILWAY_PRIVATE_DOMAIN}}:8080
FLASK_INTERNAL_URL=http://localhost:5000

PORT=8080
