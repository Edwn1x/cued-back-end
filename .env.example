# Copy this to .env and fill in your values

# Twilio (get these from twilio.com/console)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Anthropic API (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_api_key

# Database (SQLite for MVP, swap to Postgres later)
DATABASE_URL=sqlite:///baseline.db

# App
FLASK_SECRET_KEY=change-this-to-something-random
# Signs the per-user profile link the coach texts (profile_page.py). Falls back to
# FLASK_SECRET_KEY when empty; set a dedicated value: openssl rand -hex 32
PROFILE_TOKEN_SECRET=

# Photon / iMessage channel (see PHOTON_MIGRATION_HANDOFF_v2 + spectrum-sidecar/README.md).
# Both flags default off — the seam ships dark and is flipped deliberately.
IMESSAGE_CHANNEL_ENABLED=false        # route preferred_channel='imessage' users via the sidecar
PHOTON_PROVISIONING_ENABLED=false     # register new users with Spectrum at signup (allowlist)
SIDECAR_URL=                          # Railway: http://${{sidecar.RAILWAY_PRIVATE_DOMAIN}}:8080
INTERNAL_SHARED_SECRET=               # openssl rand -hex 32 — SAME value on the sidecar service
SPECTRUM_PROJECT_ID=                  # Photon dashboard → project Settings
SPECTRUM_PROJECT_SECRET=
